# Use pnpm for package management
# Strict peer dependencies to catch issues early
strict-peer-dependencies=false

# Auto install peers for convenience
auto-install-peers=true

# Shamefully hoist for better compatibility with tools expecting flat node_modules
shamefully-hoist=false

# Public hoist pattern for specific packages if needed
# public-hoist-pattern[]=*eslint*
# public-hoist-pattern[]=*prettier*

# Enable lockfile for reproducible builds
lockfile=true

# Save exact versions
save-exact=false
